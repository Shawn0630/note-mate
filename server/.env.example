# Note Mate LLM config — copy to `.env` in THIS directory (server/.env).
# server/.env is git-ignored (see .gitignore: `.env` matches at any depth).
# NEVER commit a real key. The key is never logged by the server.
#
# Used by POST /api/import/ai/propose (Gemini REST API). Without these,
# that endpoint answers 503 {error: 'LLM not configured'}.

# Gemini API key (https://aistudio.google.com/apikey)
LLM_API_KEY=

# Gemini model, e.g. gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash

# Tests / verification ONLY: when set, its value (a JSON string) is returned
# as the model response instead of calling the Gemini API — no key needed.
# Do not set this in a real deployment.
# LLM_STUB_RESPONSE={"outline": [], "noteSkeleton": "# Title\n", "chapterMap": {}}
